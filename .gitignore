# CAM delegated auth token caches — contain serialized MSAL tokens
data/cam_tokens/

# Runtime-generated data artifacts (rebuilt each cycle — not source-controlled)
data/snapshots/
data/ims_exports/
data/pending_approvals/
data/interview_kicks/

# Runtime state files — regenerated on every cycle; not source-controlled
data/cycle_history.json
data/dashboard_state.json
data/cam_sessions.json

# SQLite database — runtime artifact
data/ims.db

# Phase 16 runtime state files — regenerated by the agent on every cycle
data/cycle_heartbeat.json
data/llm_circuit.json

